# Profile: Node A - Local only (no NFS)
# Usage: source profiles/A.local.env
unset LEGGED_GYM_USE_SHARED_PATH
unset LEGGED_GYM_NFS_PATH
# Optional explicit overrides (commented out)
# export LEGGED_GYM_LOGS_ROOT=$(pwd)/legged_gym/logs
# export LEGGED_GYM_DATA_ROOT=$(pwd)/legged_gym/data

# Rsync defaults for A pushing logs to C and pulling data back
export SYNC_LOCAL_LOGS_ROOT=$(pwd)/legged_gym/logs
export SYNC_LOCAL_DATA_ROOT=$(pwd)/legged_gym/data
# export SYNC_REMOTE="user@server"
# export SYNC_REMOTE_LOGS_ROOT="/abs/path/on_C/logs"
# export SYNC_REMOTE_DATA_ROOT="/abs/path/on_C/data"
