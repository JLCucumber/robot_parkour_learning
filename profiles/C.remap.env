# Profile: Node C - Remap from /mnt/rpl_project to /cs/.../network_test
# Usage: source profiles/C.remap.env

# Remap base prefixes (used by collect.py and collect_test.py)
export COLLECT_REMAP_OLD_BASE=/mnt/rpl_project
export COLLECT_REMAP_NEW_BASE=/cs/student/projects2/rai/2024/hongboli/network_test
# Enable SummaryWriter remap (optional; auto-on when both bases set)
export COLLECT_SUMMARY_REMAP_ENABLE=1

# Optional: explicit roots on C
export LEGGED_GYM_LOGS_ROOT=$COLLECT_REMAP_NEW_BASE/logs
export LEGGED_GYM_DATA_ROOT=$COLLECT_REMAP_NEW_BASE/data

# Rsync defaults (C side usually as remote target/source)
# export SYNC_REMOTE="user@server"  # If C pulls from another host
# export SYNC_REMOTE_LOGS_ROOT="/abs/path/on_A/logs"
# export SYNC_REMOTE_DATA_ROOT="/abs/path/on_A/data"
