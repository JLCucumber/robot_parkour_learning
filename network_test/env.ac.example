# 示例环境变量（复制为 env.ac.sh 并根据你的环境修改后 source 生效）
# 远端（C 端）
export REMOTE_DIR="user_on_C@server-c:/abs/path/on_C/data/"
# 本机（A 端）
export LOCAL_DIR="/abs/path/on_A/data/"
# 可选跳板（留空表示直连）
export PROXY_JUMP=""
# 日志子目录（仅 sync_log_single.sh 用到）
export DIR_NAME="exp123/"
# Dry-run 开关（非空启用）
export RSYNC_DRYRUN=1
